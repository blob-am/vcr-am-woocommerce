<?xml version="1.0"?>
<ruleset name="vcr-am-fiscal-receipts">
    <description>
        The checks WooCommerce's QIT runs on a plugin's PHP, reproduced here so
        CI fails before a store would: the WordPress.Security and WordPress.DB
        sniffs of the Security test, and PHPCompatibility from the plugin's
        `Requires PHP` up, as the PHPCompatibility test does
        (https://qit.woo.com/docs/managed-tests/security/,
        https://qit.woo.com/docs/managed-tests/phpcompatibility/).

        Code style is Pint's (PSR-12), not WordPress's: the full WordPress
        standard reports tens of thousands of formatting differences with it,
        and neither QIT nor Plugin Check gates on formatting. Plugin Check runs
        separately against the built ZIP with its own rules.
    </description>

    <file>.</file>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/vendor-prefixed/*</exclude-pattern>
    <exclude-pattern>/vendor-bin/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>/build/*</exclude-pattern>
    <exclude-pattern>/dist/*</exclude-pattern>
    <exclude-pattern>/playground/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg value="sp"/>

    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB"/>

    <!--
        Keep in step with `Requires PHP` in the entry file and readme.txt.
        Open-ended, so every newer PHP the sniffs know is checked too.
    -->
    <config name="testVersion" value="8.3-"/>
    <rule ref="PHPCompatibilityWP"/>
</ruleset>
