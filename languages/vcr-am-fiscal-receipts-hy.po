#. Plugin Name of the plugin
msgid "VCR — Fiscal Receipts for Armenia (eHDM)"
msgstr "VCR — ֆիսկալ կտրոններ Հայաստանի համար (eHDM)"

#. Plugin URI of the plugin
msgid "https://vcr.am"
msgstr "https://vcr.am"

#. Description of the plugin
msgid "Issue Armenian fiscal receipts (eHDM) to the State Revenue Committee directly from WooCommerce orders. Multi-currency + refunds."
msgstr "Թողարկեք հայկական ֆիսկալ կտրոններ (eHDM)՝ ՊԵԿ-ում գրանցմամբ, անմիջապես WooCommerce-ի պատվերներից։ Բազմարժույթ վճարումներ և վերադարձներ։"

#. Author of the plugin
msgid "Blob Solutions"
msgstr "Blob Solutions"

#. Author URI of the plugin
msgid "https://blob.am"
msgstr "https://blob.am"

msgid "Search by code or name"
msgstr "Որոնել կոդով կամ անվանմամբ"

msgid "Type at least 2 characters of a code or a name"
msgstr "Մուտքագրեք կոդի կամ անվանման առնվազն 2 նիշ"

msgid "Searching…"
msgstr "Որոնվում է…"

msgid "No code matches. Try a shorter code or another word."
msgstr "Համապատասխան կոդ չկա։ Փորձեք ավելի կարճ կոդ կամ այլ բառ։"

msgid "Could not reach VCR to search. Check the checklist above and try again."
msgstr "Չհաջողվեց կապ հաստատել VCR-ի հետ որոնման համար։ Ստուգեք վերևի ստուգացանկը և փորձեք կրկին։"

msgid "You do not have permission to change VCR settings."
msgstr "Դուք VCR-ի կարգավորումները փոխելու թույլտվություն չունեք։"

msgid "Test connection"
msgstr "Ստուգել կապը"

msgid "Testing…"
msgstr "Ստուգվում է…"

msgid "Enter an API key first."
msgstr "Նախ մուտքագրեք API բանալին։"

msgid "Connection failed."
msgstr "Կապը չհաջողվեց։"

msgid "Network error — could not reach the server."
msgstr "Ցանցի սխալ — սերվերը հասանելի չէ։"

msgid "Timed out — VCR did not respond in time."
msgstr "Սպասման ժամանակը սպառվեց — VCR-ը ժամանակին չպատասխանեց։"

msgid "You do not have permission to test the VCR connection."
msgstr "Դուք VCR-ի կապը ստուգելու թույլտվություն չունեք։"

msgid "No API key provided and no saved key found."
msgstr "API բանալի չի մուտքագրվել, և պահպանված բանալի չկա։"

#. translators: %s is the SafeUrlValidator rejection reason.
#, php-format
msgid "Refusing to send your API key to that URL: %s"
msgstr "API բանալին այդ հասցեին չի ուղարկվի՝ %s"

#. translators: 1: business name, 2: TIN, 3: register id, 4: "sandbox" or "production".
#, php-format
msgid "Connected to %1$s (TIN %2$s), register #%3$d — %4$s."
msgstr "Միացված է՝ %1$s (ՀՎՀՀ %2$s), դրամարկղ №%3$d — %4$s։"

msgid "sandbox, receipts are test-only"
msgstr "sandbox, կտրոնները միայն փորձնական են"

msgid "production"
msgstr "production"

msgid "This register has no cashiers yet, so no receipt can be issued. Add the first one in the VCR dashboard — owner, accountant and developer accounts can all do it."
msgstr "Այս դրամարկղում դեռ գանձապահ չկա, ուստի կտրոն թողարկել հնարավոր չէ։ Ավելացրեք առաջինին VCR-ի կառավարման վահանակում — դա կարող են անել սեփականատերը, հաշվապահը և ծրագրավորողը։"

#. translators: %d is the number of cashiers on the register.
#, php-format
msgid "%d cashier available."
msgid_plural "%d cashiers available."
msgstr[0] "Հասանելի է %d գանձապահ։"
msgstr[1] "Հասանելի է %d գանձապահ։"

#. translators: %s is the technical error message.
#, php-format
msgid "Unexpected error: %s"
msgstr "Չնախատեսված սխալ՝ %s"

msgid "You do not have permission to retry fiscalisation for this order."
msgstr "Դուք այս պատվերի ֆիսկալացումը կրկնելու թույլտվություն չունեք։"

msgid "VCR Fiscal Receipt"
msgstr "VCR ֆիսկալ կտրոն"

msgid "Order not available."
msgstr "Պատվերը հասանելի չէ։"

msgid "Something wrong? Build a problem report"
msgstr "Ինչ-որ բան այն չէ՞։ Կազմեք խնդրի հաշվետվություն"

msgid "Not yet fiscalised. The plugin will queue this order automatically once payment completes."
msgstr "Դեռ ֆիսկալացված չէ։ Խրվակը պատվերն ինքնաշխատ կհերթագրի, հենց որ վճարումն ավարտվի։"

msgid "WooCommerce has not been told that this order is paid, so no receipt was requested. If the customer has in fact paid, the payment gateway did not report it back to the store: change the order status to \"Processing\" and the receipt will be registered."
msgstr "WooCommerce-ը չի ստացել այս պատվերի վճարման մասին հաղորդում, ուստի կտրոն չի պահանջվել։ Եթե գնորդն իրականում վճարել է, ուրեմն վճարային համակարգը այդ մասին չի հայտնել խանութին. պատվերի կարգավիճակը դարձրեք «Մշակվում է» (Processing), և կտրոնը կգրանցվի։"

msgid "Status:"
msgstr "Կարգավիճակ՝"

msgid "Queued for fiscalisation"
msgstr "Հերթագրված է ֆիսկալացման"

msgid "Attempts so far:"
msgstr "Փորձերի քանակը՝"

msgid "Registered with SRC"
msgstr "Գրանցված է ՊԵԿ-ում"

msgid "Fiscal serial"
msgstr "Ֆիսկալ համար"

msgid "CRN"
msgstr "ՀԴՄ ԳՀ"

msgid "Receipt id"
msgstr "Կտրոնի ID"

msgid "Failed (retries exhausted)"
msgstr "Չհաջողվեց (փորձերը սպառվել են)"

msgid "Needs your attention"
msgstr "Պահանջում է ձեր ուշադրությունը"

msgid "Fiscalize now"
msgstr "Ֆիսկալացնել հիմա"

msgid "Last error:"
msgstr "Վերջին սխալը՝"

msgid "Fiscalisation re-queued. The next attempt will run shortly."
msgstr "Ֆիսկալացումը կրկին հերթագրվեց։ Հաջորդ փորձը շուտով կկատարվի։"

msgid "Order is already fiscalised — nothing to retry."
msgstr "Պատվերն արդեն ֆիսկալացված է — կրկնելու բան չկա։"

msgid "Order is not in a state that can be retried."
msgstr "Պատվերի ներկա վիճակում կրկնել հնարավոր չէ։"

msgid "The selected order could not be found."
msgstr "Ընտրված պատվերը չի գտնվել։"

msgid "Refund registration re-queued. The next attempt will run shortly."
msgstr "Վերադարձի գրանցումը կրկին հերթագրվեց։ Հաջորդ փորձը շուտով կկատարվի։"

msgid "Refund is already registered with SRC — nothing to retry."
msgstr "Վերադարձն արդեն գրանցված է ՊԵԿ-ում — կրկնելու բան չկա։"

msgid "Refund is not in a state that can be retried."
msgstr "Վերադարձի ներկա վիճակում կրկնել հնարավոր չէ։"

msgid "The selected refund could not be found."
msgstr "Ընտրված վերադարձը չի գտնվել։"

msgid "Refunds:"
msgstr "Վերադարձներ՝"

msgid "Refund"
msgstr "Վերադարձ"

msgid "Status: not yet enqueued."
msgstr "Կարգավիճակ՝ դեռ հերթագրված չէ։"

msgid "Fiscal:"
msgstr "Ֆիսկալ համար՝"

msgid "CRN:"
msgstr "ՀԴՄ ԳՀ՝"

msgid "Receipt id:"
msgstr "Կտրոնի ID՝"

msgid "Register refund now"
msgstr "Գրանցել վերադարձը հիմա"

msgid "Queued for SRC registration"
msgstr "Հերթագրված է ՊԵԿ-ում գրանցման"

#. translators: %d: number of orders re-queued for fiscalisation
#, php-format
msgid "%d order re-queued for VCR fiscalisation."
msgid_plural "%d orders re-queued for VCR fiscalisation."
msgstr[0] "%d պատվեր կրկին հերթագրվեց VCR-ում ֆիսկալացման։"
msgstr[1] "%d պատվեր կրկին հերթագրվեց VCR-ում ֆիսկալացման։"

#. translators: %d: number of orders skipped (not in a retriable state)
#, php-format
msgid "%d order skipped (not in a retriable state)."
msgid_plural "%d orders skipped (not in a retriable state)."
msgstr[0] "%d պատվեր բաց թողնվեց (ներկա վիճակում կրկնել հնարավոր չէ)։"
msgstr[1] "%d պատվեր բաց թողնվեց (ներկա վիճակում կրկնել հնարավոր չէ)։"

msgid "Retry VCR fiscalisation"
msgstr "Կրկնել VCR ֆիսկալացումը"

msgid "Fiscal"
msgstr "Ֆիսկալացում"

msgid "Queued"
msgstr "Հերթում է"

msgid "Registered"
msgstr "Գրանցված է"

msgid "Failed"
msgstr "Չհաջողվեց"

msgid "Manual"
msgstr "Ձեռքով"

msgid "All fiscal statuses"
msgstr "Ֆիսկալացման բոլոր կարգավիճակները"

msgid "Not enqueued"
msgstr "Հերթագրված չէ"

msgid "Needs attention"
msgstr "Ուշադրություն է պահանջում"

msgid "Settings"
msgstr "Կարգավորումներ"

msgid "Docs"
msgstr "Փաստաթղթեր"

msgid "Report a problem"
msgstr "Հայտնել խնդրի մասին"

#. translators: 1: business name, 2: TIN, 3: register id, 4: register name.
#, php-format
msgid "Connected to %1$s (TIN %2$s), register #%3$d %4$s."
msgstr "Միացված է՝ %1$s (ՀՎՀՀ %2$s), դրամարկղ №%3$d %4$s։"

msgid "Connection"
msgstr "Կապ"

msgid "This is a sandbox register: receipts issued from it are test receipts and have no legal force. Save the key of your production register when you have finished testing."
msgstr "Սա sandbox դրամարկղ է. դրանից թողարկված կտրոնները փորձնական են և իրավաբանական ուժ չունեն։ Փորձարկումն ավարտելուց հետո պահպանեք ձեր production դրամարկղի բանալին։"

msgid "The register has no registration number from the tax service yet, so receipts cannot be filed. Finish its activation in the VCR dashboard."
msgstr "Դրամարկղը դեռ ՊԵԿ-ից գրանցման համար չունի, ուստի կտրոններ ներկայացնել հնարավոր չէ։ Ավարտեք դրա ակտիվացումը VCR-ի կառավարման վահանակում։"

msgid "Receipts are filed with the tax service."
msgstr "Կտրոնները գրանցվում են ՊԵԿ-ում։"

msgid "No API key saved yet. Paste the key from your VCR dashboard into the field below and press Save changes."
msgstr "API բանալին դեռ պահպանված չէ։ Տեղադրեք VCR-ի կառավարման վահանակից վերցված բանալին ստորև դաշտում և սեղմեք «Save changes»։"

msgid "Open the VCR dashboard"
msgstr "Բացել VCR-ի կառավարման վահանակը"

msgid "This server could not reach vcr.am — the request failed before any answer came back. Outbound HTTPS is usually blocked by the hosting firewall; ask your host to allow it, then reload this page."
msgstr "Այս սերվերը չկարողացավ կապվել vcr.am-ի հետ — հարցումն ընդհատվեց մինչև պատասխան ստանալը։ Սովորաբար ելքային HTTPS հարցումներն արգելափակում է հոսթինգի firewall-ը. խնդրեք ձեր հոսթինգ մատակարարին թույլատրել դրանք, ապա վերաբեռնեք էջը։"

msgid "The status report shows whether PHP can make HTTP requests at all"
msgstr "Կարգավիճակի հաշվետվությունը ցույց է տալիս՝ արդյոք PHP-ն ընդհանրապես կարող է HTTP հարցումներ ուղարկել"

msgid "vcr.am does not recognise this API key. It may have been revoked, or it may belong to a register that no longer exists — create a new key in the dashboard and save it here."
msgstr "vcr.am-ը չի ճանաչում այս API բանալին։ Հնարավոր է՝ այն չեղարկվել է կամ պատկանում է այլևս գոյություն չունեցող դրամարկղի — ստեղծեք նոր բանալի կառավարման վահանակում և պահպանեք այստեղ։"

msgid "The key works, but its register has not finished activation with the tax service and cannot issue anything yet. Finish activation in the dashboard — or create a sandbox register and use its key to test the integration first."
msgstr "Բանալին աշխատում է, բայց դրա դրամարկղը դեռ ակտիվացված չէ ՊԵԿ-ում և առայժմ ոչինչ թողարկել չի կարող։ Ավարտեք ակտիվացումը կառավարման վահանակում — կամ ստեղծեք sandbox դրամարկղ և նախ փորձարկեք ինտեգրումը դրա բանալիով։"

msgid "vcr.am refused this API key. It belongs to a different register, or its access was withdrawn."
msgstr "vcr.am-ը մերժեց այս API բանալին։ Այն պատկանում է այլ դրամարկղի, կամ դրա հասանելիությունը հետ է վերցվել։"

msgid "vcr.am answered in a way this plugin could not read. If it keeps happening, update the plugin — and send support the message below."
msgstr "vcr.am-ի պատասխանը խրվակը չկարողացավ կարդալ։ Եթե դա կրկնվում է, թարմացրեք խրվակը և ստորև բերված հաղորդագրությունն ուղարկեք աջակցման ծառայությանը։"

msgid "vcr.am answered with an error of its own. Try again in a minute; if it keeps happening, write to support."
msgstr "vcr.am-ը պատասխանեց սեփական սխալով։ Մեկ րոպեից կրկին փորձեք. եթե դա կրկնվում է, գրեք աջակցման ծառայությանը։"

#. translators: %s is a request id to quote to support.
#, php-format
msgid "vcr.am answered with an error of its own. Try again in a minute; if it keeps happening, send support this request id: %s."
msgstr "vcr.am-ը պատասխանեց սեփական սխալով։ Մեկ րոպեից կրկին փորձեք. եթե դա կրկնվում է, աջակցման ծառայությանն ուղարկեք հարցման այս նույնացուցիչը՝ %s։"

msgid "Cashier"
msgstr "Գանձապահ"

msgid "The cashier list could not be loaded just now. Reload the page; the connection itself is fine."
msgstr "Գանձապահների ցանկն այս պահին չհաջողվեց բեռնել։ Վերաբեռնեք էջը. կապն ինքնին կարգին է։"

msgid "This register has no cashiers yet, and every receipt has to name one. Add one in the VCR dashboard — owner, accountant and developer accounts can all do it, and for a one-person shop opening the register's desk once is enough — after which this page will find it."
msgstr "Այս դրամարկղում դեռ գանձապահ չկա, իսկ յուրաքանչյուր կտրոնում պետք է նշված լինի գանձապահը։ Ավելացրեք նրան VCR-ի կառավարման վահանակում — դա կարող են անել սեփականատերը, հաշվապահը և ծրագրավորողը, իսկ մեկ հոգանոց խանութի համար բավական է մեկ անգամ բացել դրամարկղը — որից հետո նա կհայտնվի այս էջում։"

msgid "Choose the cashier receipts will be issued by, below, and press Save changes."
msgstr "Ստորև ընտրեք գանձապահին, ում անունից կթողարկվեն կտրոնները, և սեղմեք «Save changes»։"

#. translators: %d is the stored cashier number.
#, php-format
msgid "The saved cashier (#%d) is not on this register any more, so receipts are being refused. Choose another one below."
msgstr "Պահպանված գանձապահը (№%d) այլևս այս դրամարկղում չէ, ուստի կտրոնները մերժվում են։ Ստորև ընտրեք մեկ ուրիշին։"

#. translators: %s is the chosen cashier's label.
#, php-format
msgid "Receipts will be issued by %s."
msgstr "Կտրոնները կթողարկվեն հետևյալ գանձապահի անունից՝ %s։"

msgid "Departments"
msgstr "Բաժիններ"

msgid "This register has no departments, so nothing can be fiscalised. Add one in the VCR dashboard."
msgstr "Այս դրամարկղում բաժիններ չկան, ուստի ոչինչ ֆիսկալացնել հնարավոր չէ։ Ավելացրեք բաժին VCR-ի կառավարման վահանակում։"

msgid "Department override"
msgstr "Բաժնի վերասահմանում"

#. translators: %d is the stored department number.
#, php-format
msgid "The saved department override (#%d) is not on this register any more, so every receipt is being refused. Choose another one below, or clear the field to file each offer under its own department."
msgstr "Վերասահմանման համար պահպանված բաժինը (№%d) այլևս այս դրամարկղում չէ, ուստի բոլոր կտրոնները մերժվում են։ Ստորև ընտրեք մեկ ուրիշը կամ մաքրեք դաշտը, որպեսզի յուրաքանչյուր ապրանք ձևակերպվի իր բաժնով։"

#. translators: %s is the department label, or its number when the list is unavailable.
#, php-format
msgid "Every line of every receipt will be filed under %s, ignoring the department each offer was registered with. The department decides the tax regime printed on the receipt, and a receipt can only be refunded, never corrected."
msgstr "Յուրաքանչյուր կտրոնի յուրաքանչյուր տող կձևակերպվի «%s» բաժնով՝ անկախ այն բաժնից, որով գրանցված է ապրանքը։ Բաժնից է կախված կտրոնում տպվող հարկային ռեժիմը, իսկ կտրոնը հնարավոր է միայն վերադարձնել, բայց ոչ ուղղել։"

msgid "Catalog"
msgstr "Կատալոգ"

msgid "A product your register has no catalog item for cannot be fiscalised: that order is held for manual review until you add the item in VCR. Set a classifier code below and the plugin creates the item itself, as it issues the receipt."
msgstr "Ապրանքը, որի համար դրամարկղի կատալոգում գրառում չկա, հնարավոր չէ ֆիսկալացնել. այդ պատվերը հետաձգվում է ձեռքով ստուգման, մինչև գրառումը չավելացնեք VCR-ում։ Ստորև նշեք դասակարգչի կոդը, և խրվակն ինքը կստեղծի գրառումը կտրոնը թողարկելիս։"

#. translators: 1: the configured classifier code, 2: the nearest accepted codes, or nothing.
#, php-format
msgid "Classifier code %1$s is not one the tax service accepts, so every order with a product new to the register is refused. Pick a code from the list below. %2$s"
msgstr "ՊԵԿ-ը չի ընդունում դասակարգչի %1$s կոդը, ուստի դրամարկղի կատալոգում դեռ չեղած ապրանքով յուրաքանչյուր պատվեր կմերժվի։ Ընտրեք կոդ ստորև ցանկից։ %2$s"

#. translators: %s: the nearest accepted codes with their names.
#, php-format
msgid "Nearest codes: %s."
msgstr "Մոտակա կոդերը՝ %s։"

msgid "This register has more than one department, so the plugin cannot tell which tax regime a new catalog item belongs to. Pick one under \"Department for new catalog items\" below; until then a product not already in the catalog holds its order."
msgstr "Այս դրամարկղն ունի մեկից ավելի բաժին, ուստի խրվակը չի կարող որոշել, թե որ հարկային ռեժիմին է պատկանում կատալոգի նոր գրառումը։ Ընտրեք բաժինը ստորև՝ «Բաժին կատալոգի նոր գրառումների համար» դաշտում. մինչ այդ կատալոգում դեռ չգրանցված ապրանքով պատվերը կհետաձգվի։"

#. translators: %s: the configured classifier code.
#, php-format
msgid "New products are added to the register's catalog under code %s as their first receipt is issued. Change a code per item in VCR any time — the plugin never overwrites one."
msgstr "Նոր ապրանքներն ավելացվում են դրամարկղի կատալոգ %s կոդով՝ առաջին կտրոնը թողարկելիս։ Առանձին գրառման կոդը ցանկացած պահի կարող եք փոխել VCR-ում — խրվակն այն երբեք չի վերագրում։"

msgid "Shipping line"
msgstr "Առաքման տող"

msgid "Shipping is enabled in this store and no Shipping SKU is set, so an order that charges for delivery will be held for manual review instead of getting a receipt. Onboard one \"shipping\" offer in the VCR catalog and name its SKU below."
msgstr "Խանութում առաքումը միացված է, իսկ առաքման SKU-ն նշված չէ, ուստի վճարովի առաքմամբ պատվերը կտրոն ստանալու փոխարեն կհետաձգվի ձեռքով ստուգման։ VCR-ի կատալոգում ստեղծեք «առաքում» գրառում և ստորև նշեք դրա SKU-ն։"

msgid "VCR — Fiscal Receipts (Armenia)"
msgstr "VCR — ֆիսկալ կտրոններ (Հայաստան)"

msgid "Plugin version"
msgstr "Խրվակի տարբերակ"

msgid "libsodium"
msgstr "libsodium"

msgid "Native extension"
msgstr "Ներկառուցված ընդլայնում"

msgid "WordPress polyfill (ext-sodium not installed)"
msgstr "WordPress polyfill (ext-sodium-ը տեղադրված չէ)"

msgid "HTTP transport"
msgstr "HTTP տրանսպորտ"

msgid "API key configured"
msgstr "API բանալին կարգավորված է"

msgid "Yes"
msgstr "Այո"

msgid "No"
msgstr "Ոչ"

msgid "Base URL"
msgstr "Հիմնական URL"

msgid "Register"
msgstr "Դրամարկղ"

msgid "Default cashier configured"
msgstr "Լռելյայն գանձապահը կարգավորված է"

msgid "Default department configured"
msgstr "Լռելյայն բաժինը կարգավորված է"

msgid "Shipping SKU configured"
msgstr "Առաքման SKU-ն կարգավորված է"

msgid "Fee SKU configured"
msgstr "Հավելավճարի SKU-ն կարգավորված է"

msgid "Fully configured"
msgstr "Ամբողջությամբ կարգավորված է"

msgid "Pending sale jobs"
msgstr "Վաճառքի սպասող առաջադրանքներ"

msgid "Pending refund jobs"
msgstr "Վերադարձի սպասող առաջադրանքներ"

msgid "Sale orders — Pending"
msgstr "Վաճառքի պատվերներ — հերթում"

msgid "Sale orders — Failed"
msgstr "Վաճառքի պատվերներ — չհաջողված"

msgid "Sale orders — Manual required"
msgstr "Վաճառքի պատվերներ — պահանջվում է ձեռքով մշակում"

msgid "Refunds — Pending"
msgstr "Վերադարձներ — հերթում"

msgid "Refunds — Failed"
msgstr "Վերադարձներ — չհաջողված"

msgid "Refunds — Manual required"
msgstr "Վերադարձներ — պահանջվում է ձեռքով մշակում"

msgid "cURL"
msgstr "cURL"

msgid "PHP streams (allow_url_fopen)"
msgstr "PHP հոսքեր (allow_url_fopen)"

msgid "None — no ext-curl and allow_url_fopen is off; VCR is unreachable from this server"
msgstr "Չկա — ext-curl-ը բացակայում է, allow_url_fopen-ն անջատված է. VCR-ն այս սերվերից հասանելի չէ"

msgid "Shipping line (from settings)"
msgstr "Առաքման տող (կարգավորումներից)"

msgid "Fee line (from settings)"
msgstr "Հավելավճարի տող (կարգավորումներից)"

#. translators: 1: tax regime name, 2: department internal id.
#, php-format
msgid "%1$s (#%2$d)"
msgstr "%1$s (№%2$d)"

#. translators: 1: tax regime name, 2: department title, 3: department internal id.
#, php-format
msgid "%1$s — %2$s (#%3$d)"
msgstr "%1$s — %2$s (№%3$d)"

msgid "VAT"
msgstr "ԱԱՀ"

msgid "VAT-exempt"
msgstr "Առանց ԱԱՀ"

msgid "Turnover tax"
msgstr "Շրջանառության հարկ"

msgid "Micro-enterprise"
msgstr "Միկրոձեռնարկատիրություն"

msgid "Shipping"
msgstr "Առաքում"

msgid "Order has shipping charges, and the plugin has no classifier code to create a shipping line with. Set \"Classifier code for new catalog items\" in WooCommerce -> Settings -> VCR, or set a Shipping SKU pointing at an offer you onboarded in VCR."
msgstr "Պատվերում կա վճարովի առաքում, իսկ խրվակը չունի դասակարգչի կոդ՝ առաքման տող ստեղծելու համար։ Լրացրեք «Դասակարգչի կոդ կատալոգի նոր գրառումների համար» դաշտը WooCommerce → Settings → VCR բաժնում կամ նշեք առաքման SKU, որը հղվում է VCR-ում ձեր ստեղծած գրառմանը։"

msgid "Service fee"
msgstr "Սպասարկման վճար"

msgid "Order has fee lines (handling, surcharge, etc.), and the plugin has no classifier code to create a fee line with. Set \"Classifier code for new catalog items\" in WooCommerce -> Settings -> VCR, or set a Fee SKU pointing at an offer you onboarded in VCR."
msgstr "Պատվերում կան հավելավճարների տողեր (մշակման վճար, հավելավճար և այլն), իսկ խրվակը չունի դասակարգչի կոդ՝ հավելավճարի տող ստեղծելու համար։ Լրացրեք «Դասակարգչի կոդ կատալոգի նոր գրառումների համար» դաշտը WooCommerce → Settings → VCR բաժնում կամ նշեք հավելավճարի SKU, որը հղվում է VCR-ում ձեր ստեղծած գրառմանը։"

msgid "Name on the fiscal receipt"
msgstr "Անվանումը ֆիսկալ կտրոնում"

#. translators: %d: maximum characters a receipt line holds.
#, php-format
msgid "Leave empty to print the product name. Set it when that name is longer than %d characters, which is all a receipt line holds -- the plugin will not shorten it for you, because this is the line the buyer reads to recognise what they bought. Variations whose own box is empty print this name too."
msgstr "Թողեք դատարկ՝ ապրանքի անվանումը տպելու համար։ Լրացրեք, եթե անվանումը %d նիշից երկար է. կտրոնի տողում ավելին չի տեղավորվում, և խրվակն այն ձեր փոխարեն չի կրճատի, քանի որ հենց այս տողով է գնորդը ճանաչում իր գնածը։ Այն տարբերակները, որոնց սեփական դաշտը դատարկ է, նույնպես տպում են այս անվանումը։"

#. translators: 1: receipt name inherited from the parent product, 2: maximum characters a receipt line holds.
#, php-format
msgid "Leave empty to use the parent product's receipt name, \"%1$s\". A receipt line holds %2$d characters."
msgstr "Թողեք դատարկ՝ ծնող ապրանքի կտրոնային անվանումն օգտագործելու համար՝ «%1$s»։ Կտրոնի տողում տեղավորվում է %2$d նիշ։"

#. translators: %d: maximum characters a receipt line holds.
#, php-format
msgid "Leave empty to print the variation name -- the product name plus its attributes, which is the longest name in your catalog. A receipt line holds %d characters, so this is the box most likely to need filling in."
msgstr "Թողեք դատարկ՝ տարբերակի անվանումը տպելու համար — ապրանքի անվանումը՝ իր հատկանիշներով, այսինքն՝ ձեր կատալոգի ամենաերկար անվանումը։ Կտրոնի տողում տեղավորվում է %d նիշ, ուստի հենց այս դաշտն է, որ ամենայն հավանականությամբ պետք կլինի լրացնել։"

#. translators: 1: register id, 2: sandbox/production, 3: business name, 4: TIN.
#, php-format
msgid "#%1$d (%2$s) — %3$s, TIN %4$s"
msgstr "№%1$d (%2$s) — %3$s, ՀՎՀՀ %4$s"

msgid "sandbox"
msgstr "sandbox"

msgid "No API key saved"
msgstr "API բանալին պահպանված չէ"

msgid "Unknown — vcr.am unreachable from this server"
msgstr "Անհայտ է — vcr.am-ն այս սերվերից հասանելի չէ"

msgid "Unknown — API key rejected"
msgstr "Անհայտ է — API բանալին մերժվել է"

msgid "Not activated with the tax service yet"
msgstr "Դեռ ակտիվացված չէ ՊԵԿ-ում"

msgid "Unknown — access to this register denied"
msgstr "Անհայտ է — այս դրամարկղի հասանելիությունը մերժվել է"

msgid "Unknown — vcr.am returned an error"
msgstr "Անհայտ է — vcr.am-ը սխալ է վերադարձրել"

msgid "Unknown — unreadable answer from vcr.am"
msgstr "Անհայտ է — vcr.am-ի պատասխանն անընթեռնելի է"

msgid "VCR plugin is not fully configured (missing API key or cashier). Open WooCommerce → Settings → VCR to finish setup, then retry."
msgstr "VCR խրվակն ամբողջությամբ կարգավորված չէ (բացակայում է API բանալին կամ գանձապահը)։ Բացեք WooCommerce → Settings → VCR, ավարտեք կարգավորումը և կրկին փորձեք։"

#. translators: 1: SRC fiscal serial number, 2: customer-facing receipt URL slug.
#, php-format
msgid "VCR fiscal receipt registered. Fiscal: %1$s. Receipt id: %2$s."
msgstr "VCR ֆիսկալ կտրոնը գրանցված է։ Ֆիսկալ համար՝ %1$s։ Կտրոնի ID՝ %2$s։"

#. translators: 1: total number of attempts, 2: error message from the last attempt.
#, php-format
msgid "Gave up after %1$d attempts. Last error: %2$s"
msgstr "Փորձերը սպառվեցին (%1$d)։ Վերջին սխալը՝ %2$s"

#. translators: 1: the configured classifier code, 2: technical detail — HTTP status, API request id, server message.
#, php-format
msgid "The tax service does not accept classifier code %1$s, set under WooCommerce → Settings → VCR → \"Classifier code for new catalog items\", so no catalog item could be created for this order's products. Pick a code from that list, then use \"Fiscalize now\" on this order; it will not be charged again. (%2$s)"
msgstr "ՊԵԿ-ը չի ընդունում դասակարգչի %1$s կոդը, որը նշված է WooCommerce → Settings → VCR → «Դասակարգչի կոդ կատալոգի նոր գրառումների համար» դաշտում, ուստի այս պատվերի ապրանքների համար կատալոգի գրառումներ ստեղծել չհաջողվեց։ Ընտրեք կոդ այդ ցանկից, ապա պատվերում սեղմեք «Ֆիսկալացնել հիմա»․ գումարը կրկին չի գանձվի։ (%2$s)"

#. translators: 1: technical detail — HTTP status, API request id, server message.
#, php-format
msgid "This order changed after its first fiscalisation attempt, so it no longer matches the receipt the tax service was asked to register. Use \"Fiscalize now\" on the order to register it as it stands. (%1$s)"
msgstr "Պատվերը փոխվել է ֆիսկալացման առաջին փորձից հետո և այլևս չի համընկնում այն կտրոնի հետ, որն ուղարկվել էր ՊԵԿ՝ գրանցման։ Պատվերում սեղմեք «Ֆիսկալացնել հիմա»՝ այն ներկա տեսքով գրանցելու համար։ (%1$s)"

msgid "Connected. This store will now file its receipts to the register you chose."
msgstr "Միացված է։ Այսուհետ խանութն իր կտրոնները կգրանցի ձեր ընտրած դրամարկղում։"

msgid "The connection was not approved, so nothing changed."
msgstr "Միացումը չի հաստատվել, ուստի ոչինչ չի փոխվել։"

msgid "That connection attempt has expired. Press Connect to VCR.AM again."
msgstr "Միացման այդ փորձի ժամկետը լրացել է։ Կրկին սեղմեք «Միանալ VCR.AM-ին»։"

msgid "Could not connect to VCR.AM. Check the error log, then try again."
msgstr "Չհաջողվեց միանալ VCR.AM-ին։ Ստուգեք սխալների մատյանը և կրկին փորձեք։"

msgid "You do not have permission to connect this store to VCR.AM."
msgstr "Դուք այս խանութը VCR.AM-ին միացնելու թույլտվություն չունեք։"

msgid "VCR — Fiscal Receipts for Armenia requires WooCommerce to be installed and active."
msgstr "«VCR — ֆիսկալ կտրոններ Հայաստանի համար» խրվակի համար WooCommerce-ը պետք է տեղադրված և ակտիվ լինի։"

msgid "VCR — Fiscal Receipts for Armenia cannot store your API key: this server has no libsodium. Ask your host to enable the PHP sodium extension."
msgstr "«VCR — ֆիսկալ կտրոններ Հայաստանի համար» խրվակը չի կարող պահպանել ձեր API բանալին. այս սերվերում libsodium չկա։ Խնդրեք ձեր հոսթինգ մատակարարին միացնել PHP-ի sodium ընդլայնումը։"

msgid "This site uses the VCR plugin to issue fiscal receipts (eHDM) to the Armenian State Revenue Committee (SRC) via the VCR.AM gateway. The text below describes the data flow and lawful basis. Edit and paste the parts relevant to your store into your published privacy policy."
msgstr "Այս կայքն օգտագործում է VCR խրվակը՝ VCR.AM դարպասի միջոցով ֆիսկալ կտրոններ (eHDM) թողարկելու և Հայաստանի Պետական եկամուտների կոմիտեում (ՊԵԿ) գրանցելու համար։ Ստորև տեքստը նկարագրում է տվյալների հոսքը և իրավական հիմքը։ Խմբագրեք այն և ձեր խանութին վերաբերող մասերը տեղադրեք ձեր հրապարակված գաղտնիության քաղաքականության մեջ։"

msgid "Suggested text:"
msgstr "Առաջարկվող տեքստ՝"

msgid "When you place an order, our store transmits the order line items, totals, taxes, payment method (cash / non-cash), currency, and the corresponding refund records (if any) to the VCR.AM fiscal-receipt operator (vcr.am, registered in the Republic of Armenia), which forwards them to the Armenian State Revenue Committee (SRC) so a fiscal receipt can be issued in your name."
msgstr "Երբ դուք պատվեր եք ձևակերպում, մեր խանութը պատվերի տողերը, ընդհանուր գումարները, հարկերը, վճարման եղանակը (կանխիկ / անկանխիկ), արժույթը և համապատասխան վերադարձների գրառումները (առկայության դեպքում) փոխանցում է ֆիսկալ կտրոնների օպերատոր VCR.AM-ին (vcr.am, գրանցված է Հայաստանի Հանրապետությունում), որն էլ դրանք փոխանցում է Հայաստանի Պետական եկամուտների կոմիտեին (ՊԵԿ), որպեսզի ձեր անունով ֆիսկալ կտրոն թողարկվի։"

msgid "We do NOT transmit your name, email address, phone number, billing address, or IP address to VCR.AM or to the SRC. Fiscal receipts are issued to an anonymised buyer record. The personal data we collect at checkout (name, address, etc.) stays in this store for order fulfilment under our usual policies."
msgstr "Մենք ՉԵՆՔ փոխանցում ձեր անունը, էլեկտրոնային փոստի հասցեն, հեռախոսահամարը, վճարման հասցեն կամ IP հասցեն ո՛չ VCR.AM-ին, ո՛չ ՊԵԿ-ին։ Ֆիսկալ կտրոնները թողարկվում են գնորդի անանունացված գրառման վրա։ Պատվերը ձևակերպելիս հավաքվող անձնական տվյալները (անուն, հասցե և այլն) մնում են այս խանութում՝ պատվերի կատարման համար, մեր սովորական կանոնների համաձայն։"

msgid "Lawful basis: GDPR Article 6(1)(c) — processing necessary for compliance with a legal obligation. The obligation is set out in the Armenian Tax Code Article 380.1 (HO-280-N) and Government Decision 1976-N, which require electronic Cash Register (e-HDM) registration of every taxable sale."
msgstr "Իրավական հիմք՝ GDPR-ի 6(1)(c) հոդված — մշակումն անհրաժեշտ է իրավական պարտականության կատարման համար։ Պարտականությունը սահմանված է Հայաստանի Հարկային օրենսգրքի 380.1 հոդվածով (ՀՕ-280-Ն) և Կառավարության 1976-Ն որոշմամբ, որոնք պահանջում են յուրաքանչյուր հարկվող վաճառք գրանցել էլեկտրոնային հսկիչ-դրամարկղային մեքենայով (e-HDM)։"

msgid "International transfer: VCR.AM operates from the Republic of Armenia, which is not on the European Commission's list of countries with an adequate level of data protection. The transfer is governed by the Standard Contractual Clauses (Commission Implementing Decision (EU) 2021/914), Module Two (controller-to-processor); ask vcr.am for a signed Data Processing Addendum incorporating those clauses before activating the plugin in production."
msgstr "Միջազգային փոխանցում՝ VCR.AM-ը գործում է Հայաստանի Հանրապետությունից, որը ներառված չէ տվյալների պաշտպանության բավարար մակարդակ ունեցող երկրների՝ Եվրոպական հանձնաժողովի ցանկում։ Փոխանցումը կարգավորվում է Ստանդարտ պայմանագրային դրույթներով (Հանձնաժողովի (ԵՄ) 2021/914 կատարողական որոշում), Մոդուլ 2 (վերահսկողից մշակողին). մինչև խրվակը production ռեժիմում ակտիվացնելը vcr.am-ից խնդրեք այդ դրույթները ներառող՝ ստորագրված Տվյալների մշակման համաձայնագիր։"

msgid "Retention: fiscal records are retained for the period required by the Armenian Tax Code (typically 5 years from the year-end in which the receipt was issued, per Tax Code Article 56). Erasure requests covering fiscal records are refused on legal-obligation grounds under GDPR Article 17(3)(b); local plugin metadata for orders that never resulted in an SRC submission is erased on request."
msgstr "Պահպանման ժամկետ՝ ֆիսկալ գրառումները պահվում են Հայաստանի Հարկային օրենսգրքով պահանջվող ժամկետով (սովորաբար 5 տարի՝ կտրոնի թողարկման տարվա ավարտից հաշված, Հարկային օրենսգրքի 56-րդ հոդվածի համաձայն)։ Ֆիսկալ գրառումները ջնջելու հարցումները մերժվում են իրավական պարտականության հիմքով՝ GDPR-ի 17(3)(b) հոդվածի համաձայն. խրվակի տեղային մետատվյալները այն պատվերների համար, որոնք այդպես էլ չեն ուղարկվել ՊԵԿ, ջնջվում են ըստ հարցման։"

msgid "Sub-processor: VCR.AM acts as a processor on the merchant's behalf for the purpose of fiscal-receipt issuance. The Armenian SRC is an independent controller receiving the data under national tax law. Both are listed here so that a data subject can identify recipients per GDPR Article 13(1)(e)."
msgstr "Ենթամշակող՝ VCR.AM-ը գործում է որպես մշակող՝ վաճառողի անունից, ֆիսկալ կտրոններ թողարկելու նպատակով։ Հայաստանի ՊԵԿ-ը անկախ վերահսկող է, որը տվյալները ստանում է ազգային հարկային օրենսդրության հիման վրա։ Երկուսն էլ նշված են այստեղ, որպեսզի տվյալների սուբյեկտը կարողանա պարզել ստացողներին՝ GDPR-ի 13(1)(e) հոդվածի համաձայն։"

msgid "VCR Fiscal Receipts"
msgstr "VCR ֆիսկալ կտրոններ"

#. translators: %d: WC order id
#, php-format
msgid "VCR fiscal record for order #%d retained on legal-obligation grounds: GDPR Article 17(3)(b) — processing necessary for compliance with Armenian Tax Code Article 380.1 (HO-280-N), retention period per Tax Code Article 56 (typically 5 years from year-end). The SRC-side fiscal receipt is unaffected by this request."
msgstr "№%d պատվերի VCR ֆիսկալ գրառումը պահպանվել է իրավական պարտականության հիմքով՝ GDPR-ի 17(3)(b) հոդված — մշակումն անհրաժեշտ է Հայաստանի Հարկային օրենսգրքի 380.1 հոդվածի (ՀՕ-280-Ն) պահանջները կատարելու համար, պահպանման ժամկետը՝ Հարկային օրենսգրքի 56-րդ հոդվածի համաձայն (սովորաբար 5 տարի՝ տարվա ավարտից հաշված)։ ՊԵԿ-ում պահվող ֆիսկալ կտրոնի վրա այս հարցումը չի ազդում։"

