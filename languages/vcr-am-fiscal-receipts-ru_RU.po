msgstr "Настройка завершена"

msgid "Pending sale jobs"
msgstr "Задач продаж в очереди"

msgid "Pending refund jobs"
msgstr "Задач возвратов в очереди"

msgid "Sale orders — Pending"
msgstr "Заказы — в очереди"

