#. Plugin Name of the plugin
msgid "VCR — Fiscal Receipts for Armenia (eHDM)"
msgstr "VCR — фискальные чеки для Армении (eHDM)"

#. Plugin URI of the plugin
msgid "https://vcr.am"
msgstr "https://vcr.am"

#. Description of the plugin
msgid "Issue Armenian fiscal receipts (eHDM) to the State Revenue Committee directly from WooCommerce orders. Multi-currency + refunds."
msgstr "Выдавайте армянские фискальные чеки (eHDM) с регистрацией в налоговой прямо из заказов WooCommerce. Мультивалютность и возвраты."

#. Author of the plugin
msgid "Blob Solutions"
msgstr "Blob Solutions"

#. Author URI of the plugin
msgid "https://blob.am"
msgstr "https://blob.am"

msgid "Search by code or name"
msgstr "Поиск по коду или названию"

msgid "Type at least 2 characters of a code or a name"
msgstr "Введите хотя бы 2 символа кода или названия"

msgid "Searching…"
msgstr "Ищем…"

msgid "No code matches. Try a shorter code or another word."
msgstr "Подходящих кодов нет. Попробуйте код покороче или другое слово."

msgid "Could not reach VCR to search. Check the checklist above and try again."
msgstr "Не удалось связаться с VCR для поиска. Проверьте чек-лист выше и попробуйте снова."

msgid "You do not have permission to change VCR settings."
msgstr "У вас нет прав на изменение настроек VCR."

msgid "Test connection"
msgstr "Проверить подключение"

msgid "Testing…"
msgstr "Проверяем…"

msgid "Enter an API key first."
msgstr "Сначала введите API-ключ."

msgid "Connection failed."
msgstr "Не удалось подключиться."

msgid "Network error — could not reach the server."
msgstr "Ошибка сети — сервер недоступен."

msgid "Timed out — VCR did not respond in time."
msgstr "Время ожидания истекло — VCR не ответил вовремя."

msgid "You do not have permission to test the VCR connection."
msgstr "У вас нет прав на проверку подключения к VCR."

msgid "No API key provided and no saved key found."
msgstr "API-ключ не введён, и сохранённого ключа нет."

#. translators: %s is the SafeUrlValidator rejection reason.
#, php-format
msgid "Refusing to send your API key to that URL: %s"
msgstr "API-ключ не будет отправлен на этот адрес: %s"

#. translators: 1: business name, 2: TIN, 3: register id, 4: "sandbox" or "production".
#, php-format
msgid "Connected to %1$s (TIN %2$s), register #%3$d — %4$s."
msgstr "Подключено: %1$s (ИНН %2$s), касса №%3$d — %4$s."

msgid "sandbox, receipts are test-only"
msgstr "sandbox, чеки только тестовые"

msgid "production"
msgstr "production"

msgid "This register has no cashiers yet, so no receipt can be issued. Add the first one in the VCR dashboard — owner, accountant and developer accounts can all do it."
msgstr "В этой кассе пока нет кассиров, поэтому чек выдать нельзя. Добавьте первого в панели управления VCR — это могут сделать владелец, бухгалтер и разработчик."

#. translators: %d is the number of cashiers on the register.
#, php-format
msgid "%d cashier available."
msgid_plural "%d cashiers available."
msgstr[0] "Доступен %d кассир."
msgstr[1] "Доступно %d кассира."
msgstr[2] "Доступно %d кассиров."

#. translators: %s is the technical error message.
#, php-format
msgid "Unexpected error: %s"
msgstr "Непредвиденная ошибка: %s"

msgid "You do not have permission to retry fiscalisation for this order."
msgstr "У вас нет прав на повторную фискализацию этого заказа."

msgid "VCR Fiscal Receipt"
msgstr "Фискальный чек VCR"

msgid "Order not available."
msgstr "Заказ недоступен."

msgid "Something wrong? Build a problem report"
msgstr "Что-то не так? Соберите отчёт о проблеме"

msgid "Not yet fiscalised. The plugin will queue this order automatically once payment completes."
msgstr "Ещё не фискализирован. Плагин поставит заказ в очередь автоматически, как только пройдёт оплата."

msgid "WooCommerce has not been told that this order is paid, so no receipt was requested. If the customer has in fact paid, the payment gateway did not report it back to the store: change the order status to \"Processing\" and the receipt will be registered."
msgstr "WooCommerce не получил сообщения об оплате этого заказа, поэтому чек не запрашивался. Если покупатель на самом деле заплатил, значит, платёжный шлюз не сообщил об этом магазину: переведите заказ в статус «Обработка», и чек будет зарегистрирован."

msgid "Status:"
msgstr "Статус:"

msgid "Queued for fiscalisation"
msgstr "В очереди на фискализацию"

msgid "Attempts so far:"
msgstr "Попыток:"

msgid "Registered with SRC"
msgstr "Зарегистрирован в налоговой"

msgid "Fiscal serial"
msgstr "Фискальный номер"

msgid "CRN"
msgstr "РН"

msgid "Receipt id"
msgstr "ID чека"

msgid "Failed (retries exhausted)"
msgstr "Не удалось (попытки исчерпаны)"

msgid "Needs your attention"
msgstr "Требует вашего внимания"

msgid "Fiscalize now"
msgstr "Фискализировать сейчас"

msgid "Last error:"
msgstr "Последняя ошибка:"

msgid "Fiscalisation re-queued. The next attempt will run shortly."
msgstr "Фискализация снова поставлена в очередь. Следующая попытка начнётся в ближайшее время."

msgid "Order is already fiscalised — nothing to retry."
msgstr "Заказ уже фискализирован — повторять нечего."

msgid "Order is not in a state that can be retried."
msgstr "В текущем состоянии заказа повтор невозможен."

msgid "The selected order could not be found."
msgstr "Выбранный заказ не найден."

msgid "Refund registration re-queued. The next attempt will run shortly."
msgstr "Регистрация возврата снова поставлена в очередь. Следующая попытка начнётся в ближайшее время."

msgid "Refund is already registered with SRC — nothing to retry."
msgstr "Возврат уже зарегистрирован в налоговой — повторять нечего."

msgid "Refund is not in a state that can be retried."
msgstr "В текущем состоянии возврата повтор невозможен."

msgid "The selected refund could not be found."
msgstr "Выбранный возврат не найден."

msgid "Refunds:"
msgstr "Возвраты:"

msgid "Refund"
msgstr "Возврат"

msgid "Status: not yet enqueued."
msgstr "Статус: ещё не в очереди."

msgid "Fiscal:"
msgstr "Фискальный номер:"

msgid "CRN:"
msgstr "РН:"

msgid "Receipt id:"
msgstr "ID чека:"

msgid "Register refund now"
msgstr "Зарегистрировать возврат сейчас"

msgid "Queued for SRC registration"
msgstr "В очереди на регистрацию в налоговой"

#. translators: %d: number of orders re-queued for fiscalisation
#, php-format
msgid "%d order re-queued for VCR fiscalisation."
msgid_plural "%d orders re-queued for VCR fiscalisation."
msgstr[0] "%d заказ снова поставлен в очередь на фискализацию в VCR."
msgstr[1] "%d заказа снова поставлены в очередь на фискализацию в VCR."
msgstr[2] "%d заказов снова поставлены в очередь на фискализацию в VCR."

#. translators: %d: number of orders skipped (not in a retriable state)
#, php-format
msgid "%d order skipped (not in a retriable state)."
msgid_plural "%d orders skipped (not in a retriable state)."
msgstr[0] "%d заказ пропущен (в его состоянии повтор невозможен)."
msgstr[1] "%d заказа пропущены (в их состоянии повтор невозможен)."
msgstr[2] "%d заказов пропущено (в их состоянии повтор невозможен)."

msgid "Retry VCR fiscalisation"
msgstr "Повторить фискализацию в VCR"

msgid "Fiscal"
msgstr "Фискализация"

msgid "Queued"
msgstr "В очереди"

msgid "Registered"
msgstr "Зарегистрирован"

msgid "Failed"
msgstr "Ошибка"

msgid "Manual"
msgstr "Вручную"

msgid "All fiscal statuses"
msgstr "Все статусы фискализации"

msgid "Not enqueued"
msgstr "Не в очереди"

msgid "Needs attention"
msgstr "Требует внимания"

msgid "Settings"
msgstr "Настройки"

msgid "Docs"
msgstr "Документация"

msgid "Report a problem"
msgstr "Сообщить о проблеме"

#. translators: 1: business name, 2: TIN, 3: register id, 4: register name.
#, php-format
msgid "Connected to %1$s (TIN %2$s), register #%3$d %4$s."
msgstr "Подключено: %1$s (ИНН %2$s), касса №%3$d %4$s."

msgid "Connection"
msgstr "Подключение"

msgid "This is a sandbox register: receipts issued from it are test receipts and have no legal force. Save the key of your production register when you have finished testing."
msgstr "Это sandbox-касса: выданные из неё чеки — тестовые и не имеют юридической силы. Когда закончите тестирование, сохраните ключ production-кассы."

msgid "The register has no registration number from the tax service yet, so receipts cannot be filed. Finish its activation in the VCR dashboard."
msgstr "У кассы ещё нет регистрационного номера от налоговой, поэтому чеки подавать нельзя. Завершите активацию кассы в панели управления VCR."

msgid "Receipts are filed with the tax service."
msgstr "Чеки регистрируются в налоговой."

msgid "No API key saved yet. Paste the key from your VCR dashboard into the field below and press Save changes."
msgstr "API-ключ ещё не сохранён. Вставьте ключ из панели управления VCR в поле ниже и нажмите «Сохранить изменения»."

msgid "Open the VCR dashboard"
msgstr "Открыть панель управления VCR"

msgid "This server could not reach vcr.am — the request failed before any answer came back. Outbound HTTPS is usually blocked by the hosting firewall; ask your host to allow it, then reload this page."
msgstr "Этот сервер не смог связаться с vcr.am — запрос оборвался до получения ответа. Обычно исходящие HTTPS-запросы блокирует файрвол хостинга: попросите хостинг-провайдера разрешить их и перезагрузите страницу."

msgid "The status report shows whether PHP can make HTTP requests at all"
msgstr "В отчёте о состоянии видно, может ли PHP вообще отправлять HTTP-запросы"

msgid "vcr.am does not recognise this API key. It may have been revoked, or it may belong to a register that no longer exists — create a new key in the dashboard and save it here."
msgstr "vcr.am не узнаёт этот API-ключ. Возможно, он отозван или относится к кассе, которой больше нет, — создайте новый ключ в панели управления и сохраните его здесь."

msgid "The key works, but its register has not finished activation with the tax service and cannot issue anything yet. Finish activation in the dashboard — or create a sandbox register and use its key to test the integration first."
msgstr "Ключ рабочий, но его касса ещё не активирована в налоговой и пока ничего выдавать не может. Завершите активацию в панели управления — или создайте sandbox-кассу и сначала проверьте интеграцию с её ключом."

msgid "vcr.am refused this API key. It belongs to a different register, or its access was withdrawn."
msgstr "vcr.am отклонил этот API-ключ. Он относится к другой кассе, или доступ по нему отозван."

msgid "vcr.am answered in a way this plugin could not read. If it keeps happening, update the plugin — and send support the message below."
msgstr "vcr.am прислал ответ, который плагин не смог разобрать. Если это повторяется, обновите плагин и отправьте в поддержку сообщение ниже."

msgid "vcr.am answered with an error of its own. Try again in a minute; if it keeps happening, write to support."
msgstr "vcr.am ответил собственной ошибкой. Повторите через минуту; если это повторяется, напишите в поддержку."

#. translators: %s is a request id to quote to support.
#, php-format
msgid "vcr.am answered with an error of its own. Try again in a minute; if it keeps happening, send support this request id: %s."
msgstr "vcr.am ответил собственной ошибкой. Повторите через минуту; если это повторяется, отправьте в поддержку идентификатор запроса: %s."

msgid "Cashier"
msgstr "Кассир"

msgid "The cashier list could not be loaded just now. Reload the page; the connection itself is fine."
msgstr "Список кассиров сейчас не удалось загрузить. Перезагрузите страницу; само подключение в порядке."

msgid "This register has no cashiers yet, and every receipt has to name one. Add one in the VCR dashboard — owner, accountant and developer accounts can all do it, and for a one-person shop opening the register's desk once is enough — after which this page will find it."
msgstr "В этой кассе пока нет кассиров, а в каждом чеке должен быть указан кассир. Добавьте его в панели управления VCR — это могут сделать владелец, бухгалтер и разработчик, а магазину из одного человека достаточно один раз открыть кассу, — после этого он появится на этой странице."

msgid "Choose the cashier receipts will be issued by, below, and press Save changes."
msgstr "Выберите ниже кассира, от имени которого будут выдаваться чеки, и нажмите «Сохранить изменения»."

#. translators: %d is the stored cashier number.
#, php-format
msgid "The saved cashier (#%d) is not on this register any more, so receipts are being refused. Choose another one below."
msgstr "Сохранённого кассира (№%d) в этой кассе больше нет, поэтому чеки отклоняются. Выберите другого ниже."

#. translators: %s is the chosen cashier's label.
#, php-format
msgid "Receipts will be issued by %s."
msgstr "Чеки будет выдавать %s."

msgid "Departments"
msgstr "Отделы"

msgid "This register has no departments, so nothing can be fiscalised. Add one in the VCR dashboard."
msgstr "В этой кассе нет отделов, поэтому фискализировать ничего нельзя. Добавьте отдел в панели управления VCR."

msgid "Department override"
msgstr "Переопределение отдела"

#. translators: %d is the stored department number.
#, php-format
msgid "The saved department override (#%d) is not on this register any more, so every receipt is being refused. Choose another one below, or clear the field to file each offer under its own department."
msgstr "Сохранённого отдела для переопределения (№%d) в этой кассе больше нет, поэтому все чеки отклоняются. Выберите другой ниже или очистите поле, чтобы каждая позиция проводилась по своему отделу."

#. translators: %s is the department label, or its number when the list is unavailable.
#, php-format
msgid "Every line of every receipt will be filed under %s, ignoring the department each offer was registered with. The department decides the tax regime printed on the receipt, and a receipt can only be refunded, never corrected."
msgstr "Каждая строка каждого чека будет проведена по отделу «%s», независимо от того, с каким отделом зарегистрирована позиция. От отдела зависит режим налогообложения, который печатается в чеке, а чек можно только вернуть, но не исправить."

msgid "Catalog"
msgstr "Каталог"

msgid "A product your register has no catalog item for cannot be fiscalised: that order is held for manual review until you add the item in VCR. Set a classifier code below and the plugin creates the item itself, as it issues the receipt."
msgstr "Товар, для которого в каталоге кассы нет позиции, фискализировать нельзя: такой заказ откладывается на ручную проверку, пока вы не добавите позицию в VCR. Укажите ниже код классификатора — и плагин будет создавать позицию сам при выдаче чека."

#. translators: 1: the configured classifier code, 2: the nearest accepted codes, or nothing.
#, php-format
msgid "Classifier code %1$s is not one the tax service accepts, so every order with a product new to the register is refused. Pick a code from the list below. %2$s"
msgstr "Налоговая не принимает код классификатора %1$s, поэтому каждый заказ с товаром, которого ещё нет в каталоге кассы, будет отклонён. Выберите код из списка ниже. %2$s"

#. translators: %s: the nearest accepted codes with their names.
#, php-format
msgid "Nearest codes: %s."
msgstr "Ближайшие коды: %s."

msgid "This register has more than one department, so the plugin cannot tell which tax regime a new catalog item belongs to. Pick one under \"Department for new catalog items\" below; until then a product not already in the catalog holds its order."
msgstr "В этой кассе больше одного отдела, поэтому плагин не может определить, к какому режиму налогообложения относится новая позиция каталога. Выберите отдел ниже, в поле «Отдел для новых позиций каталога»; до тех пор заказ с товаром, которого ещё нет в каталоге, будет отложен."

#. translators: %s: the configured classifier code.
#, php-format
msgid "New products are added to the register's catalog under code %s as their first receipt is issued. Change a code per item in VCR any time — the plugin never overwrites one."
msgstr "Новые товары добавляются в каталог кассы с кодом %s при выдаче первого чека. Код отдельной позиции можно в любой момент изменить в VCR — плагин его не перезаписывает."

msgid "Shipping line"
msgstr "Строка доставки"

msgid "Shipping is enabled in this store and no Shipping SKU is set, so an order that charges for delivery will be held for manual review instead of getting a receipt. Onboard one \"shipping\" offer in the VCR catalog and name its SKU below."
msgstr "В магазине включена доставка, а артикул доставки не задан, поэтому заказ с платной доставкой будет отложен на ручную проверку и не получит чек. Заведите в каталоге VCR позицию «доставка» и укажите её артикул ниже."

msgid "VCR — Fiscal Receipts (Armenia)"
msgstr "VCR — фискальные чеки (Армения)"

